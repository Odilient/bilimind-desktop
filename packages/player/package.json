{
  "name": "@bilimind/player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 course player built to one file:// safe HTML template (dist/player.html).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "demo": "node scripts/paste-fixture.mjs",
    "build:demo": "vite build && node scripts/paste-fixture.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bilimind/core": "workspace:*",
    "marked": "18.1.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "puppeteer-core": "25.13.0",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
