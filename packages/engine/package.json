    "sql.js": "1.14.2",
    "ts-fsrs": "5.4.2",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/sql.js": "1.4.11",
    "puppeteer-core": "25.13.0",
    "vitest": "5.0.3"
  }
}
