{
  "name": "@bilimind/engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Node-only engine: ingest, llm, outline, exam-map, plan, draft, validate, code tests, evidence/verdict, tts, review, exports, build.",
