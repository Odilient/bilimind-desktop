{
  "name": "bilimind-desktop",
  "private": true,
  "type": "module",
  "description": "BiliMind Desktop: turn your own files into a checked, narrated course. Open source, local files, bring your own AI key.",
  "license": "AGPL-3.0-only",
  "repository": "github:Odilient/bilimind-desktop",
  "packageManager": "pnpm@10.18.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @bilimind/desktop dev",
    "start": "pnpm build && pnpm --filter @bilimind/desktop start",
    "dist": "pnpm --filter @bilimind/player build && pnpm --filter @bilimind/desktop dist",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vitest": "5.0.3",
    "@types/node": "^24.0.0"
  }
}
