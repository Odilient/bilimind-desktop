# registry.npmjs.org is blocked by the venue FortiGate. registry.yarnpkg.com serves metadata but its
# tarball URLs point at registry.npmjs.org (TLS fails), so installs use npmmirror (verified 2026-10-10).
registry=https://registry.npmmirror.com/
# Electron and electron-builder download their binaries from GitHub by default; the venue firewall breaks that.
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
