{
  "name": "@bilimind/cli",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "bilimind CLI (commander). Bundled by esbuild into skills/bilimind/scripts/bilimind.mjs.",
  "bin": {
    "bilimind": "./src/main.ts"
  },
  "scripts": {
    "start": "node src/main.ts",
    "bundle": "node scripts/bundle.mjs",
    "verify-bundle": "node scripts/verify-bundle.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bilimind/core": "workspace:*",
    "@bilimind/engine": "workspace:*",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "vitest": "5.0.3"
  }
}
