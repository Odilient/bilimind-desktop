{
  "name": "@bilimind/companion",
  "productName": "BiliMind",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "BiliMind on your computer: your courses, plan, notes and whiteboards in a local database, with your own AI key.",
  "author": {
    "name": "BiliMind team",
    "email": "oybek@bilimind.com"
  },
  "homepage": "https://github.com/bilimind/desktop",
  "desktopName": "com.bilimind.companion.desktop",
  "license": "AGPL-3.0-only",
  "main": "dist/main/main.cjs",
  "scripts": {
    "merge": "node scripts/merge.mjs",
    "postinstall": "node scripts/merge.mjs",
    "spa": "node scripts/merge.mjs && nuxt generate && node scripts/spa.mjs",
    "build": "node scripts/merge.mjs && node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "node scripts/merge.mjs && nuxt prepare && vue-tsc -b --noEmit && tsc -p tsconfig.shell.json",
    "test": "node scripts/merge.mjs && vitest run",
    "e2e": "node test/e2e.mjs",
    "dist": "node scripts/dist.mjs"
  },
