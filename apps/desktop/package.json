{
  "name": "@bilimind/desktop",
  "productName": "BiliMind Desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BiliMind Desktop: drop in your files, get a checked, narrated course. Open source, bring your own AI key.",
  "author": { "name": "BiliMind team", "email": "oybek@bilimind.com" },
  "homepage": "https://github.com/Odilient/bilimind-desktop",
  "desktopName": "bilimind-desktop.desktop",
  "license": "AGPL-3.0-only",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dist": "node scripts/dist.mjs",
    "typecheck": "vue-tsc --noEmit -p src/renderer/tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "e2e:main": "node scripts/e2e-main.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@bilimind/core": "workspace:*",
    "@bilimind/engine": "workspace:*",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.13.0",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue-tsc": "3.3.12"
  }
}
